# Copy this file to .env in the backend/ folder and fill in real values before deploying.
# In local dev, config.py's defaults work fine without a .env file.

DOCMIND_SECRET_KEY=change-me-to-a-random-secret-in-production
DOCMIND_DATABASE_URL=sqlite:///./docmind.db
DOCMIND_EMBEDDING_MODEL=all-MiniLM-L6-v2
DOCMIND_NLI_MODEL=cross-encoder/nli-deberta-v3-small
DOCMIND_LLM_MODEL=llama3
DOCMIND_ALLOWED_ORIGINS=http://localhost:3000
